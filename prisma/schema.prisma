generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  PRODUCTION
  FINANCE
  SALES
}

enum OrderStatus {
  RECEIVED
  WAITING_MATERIAL
  CUTTING
  SEWING
  EMBROIDERY_PRINT
  FINISHING
  READY
  DELIVERED
  CANCELED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum OrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Company {
  id        String   @id @default(cuid())
  name      String
  document  String?  @unique
  phone     String?
  email     String?
  address   String?
  features  String[] @default([]) // módulos vendáveis liberados p/ esta empresa (o núcleo é sempre incluso)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  clients          Client[]
  products         Product[]
  orders           Order[]
  productionStages ProductionStage[]
  materials        Material[]
  partners         Partner[]
  signupTokens     SignupToken[]
  orderRequests    OrderRequest[]
  mesas            Mesa[]
  bancadaTasks     BancadaTask[]

  @@map("empresas")
}

model SignupToken {
  id             String    @id @default(cuid())
  code           String    @unique
  clientName     String?
  contactEmail   String?
  features       String[]  @default([]) // plano que este token concede à empresa criada
  createdByEmail String
  usedAt         DateTime?
  revokedAt      DateTime?
  usedCompanyId  String?
  usedByEmail    String?
  createdAt      DateTime  @default(now())

  usedCompany Company? @relation(fields: [usedCompanyId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([usedCompanyId])
  @@map("tokens_cadastro")
}

model Partner {
  id        String   @id @default(cuid())
  companyId String
  name      String
  service   String?
  contact   String?
  phone     String?
  email     String?
  notes     String?  @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@index([companyId])
  @@map("terceirizadas")
}

model User {
  id        String   @id @default(cuid())
  companyId String
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(ADMIN)
  sector    String?
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bancadaTasks BancadaTask[]

  @@index([companyId])
  @@map("usuarios")
}

model Client {
  id            String   @id @default(cuid())
  companyId     String
  name          String
  document      String?
  contact       String?
  phone         String?
  email         String?
  address       String?
  notes         String?  @db.Text
  // Portal do cliente (login próprio, conectado à confecção por convite).
  passwordHash  String?
  inviteToken   String?  @unique
  portalEnabled Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orders        Order[]
  orderRequests OrderRequest[]

  @@index([companyId])
  @@map("clientes")
}

// Solicitação feita pelo cliente no portal; a confecção aceita (vira pedido) ou recusa.
model OrderRequest {
  id               String    @id @default(cuid())
  companyId        String
  clientId         String
  kind             String    @default("NEW") // NEW | REORDER
  referenceOrderId String?
  description      String    @db.Text
  quantity         Int?
  photoUrl         String?
  status           String    @default("PENDING") // PENDING | ACCEPTED | REJECTED
  reviewNote       String?
  reviewedAt       DateTime?
  createdOrderId   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([clientId])
  @@map("solicitacoes")
}

// Mesa/bancada de trabalho (ex.: silk). Cadastro configurável por empresa.
model Mesa {
  id        String   @id @default(cuid())
  companyId String
  name      String
  active    Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tasks   BancadaTask[]

  @@index([companyId])
  @@map("mesas")
}

// Trabalho de bancada: o funcionário "pega" um pedido numa mesa e depois conclui.
model BancadaTask {
  id           String    @id @default(cuid())
  companyId    String
  orderId      String
  mesaId       String?
  pickedById   String?
  pickedByName String
  status       String    @default("PICKED") // PICKED | DONE
  noteKind     String    @default("NONE") // NONE | SHORTAGE | SURPLUS | INFO
  note         String?
  pickedAt     DateTime  @default(now())
  doneAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company  Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order    Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  mesa     Mesa?   @relation(fields: [mesaId], references: [id], onDelete: SetNull)
  pickedBy User?   @relation(fields: [pickedById], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([orderId])
  @@index([mesaId])
  @@map("bancada_tarefas")
}

model Product {
  id                    String   @id @default(cuid())
  companyId             String
  name                  String
  category              String?
  size                  String?
  color                 String?
  fabric                String?
  standardPriceInCents  Int      @default(0)
  costInCents           Int      @default(0)
  averageProductionDays Int?
  imageUrl              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  company Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   OrderItem[]
  bom     ProductMaterial[]

  @@index([companyId])
  @@map("produtos")
}

model ProductMaterial {
  id              String   @id @default(cuid())
  productId       String
  materialId      String
  quantityPerUnit Decimal  @db.Decimal(12, 3)
  createdAt       DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([productId, materialId])
  @@index([productId])
  @@index([materialId])
  @@map("ficha_tecnica")
}

model Order {
  id                   String        @id @default(cuid())
  companyId            String
  clientId             String
  number               Int
  orderDate            DateTime      @default(now())
  deliveryDate         DateTime?
  status               OrderStatus   @default(RECEIVED)
  priority             OrderPriority @default(NORMAL)
  assignee             String?
  paymentStatus        PaymentStatus @default(PENDING)
  totalAmountInCents   Int           @default(0)
  paidAmountInCents    Int           @default(0)
  paymentMethod        String?
  internalNotes        String?       @db.Text
  currentStageId       String?
  partnerId            String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client         Client              @relation(fields: [clientId], references: [id])
  currentStage   ProductionStage?    @relation(fields: [currentStageId], references: [id])
  partner        Partner?            @relation(fields: [partnerId], references: [id])
  items          OrderItem[]
  history        ProductionHistory[]
  payments       Payment[]
  attachments    Attachment[]
  stockMovements StockMovement[]
  bancadaTasks   BancadaTask[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([clientId])
  @@index([currentStageId])
  @@index([partnerId])
  @@map("pedidos")
}

model OrderItem {
  id                 String   @id @default(cuid())
  orderId            String
  productId          String?
  description        String
  size               String?
  color              String?
  quantity           Int
  unitPriceInCents   Int      @default(0)
  totalPriceInCents  Int      @default(0)
  createdAt          DateTime @default(now())

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("pedido_itens")
}

model ProductionStage {
  id        String   @id @default(cuid())
  companyId String
  name      String
  position  Int
  color     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  currentOrders Order[]
  fromHistory   ProductionHistory[] @relation("fromStage")
  toHistory     ProductionHistory[] @relation("toStage")

  @@unique([companyId, name])
  @@index([companyId])
  @@map("etapas_producao")
}

model ProductionHistory {
  id          String   @id @default(cuid())
  orderId     String
  fromStageId String?
  toStageId   String
  note        String?
  changedAt   DateTime @default(now())

  order     Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStage ProductionStage? @relation("fromStage", fields: [fromStageId], references: [id])
  toStage   ProductionStage  @relation("toStage", fields: [toStageId], references: [id])

  @@index([orderId])
  @@index([fromStageId])
  @@index([toStageId])
  @@map("historico_status")
}

model Material {
  id             String   @id @default(cuid())
  companyId      String
  name           String
  category       String?
  unit           String
  currentQuantity Decimal  @default(0) @db.Decimal(12, 2)
  minimumQuantity Decimal  @default(0) @db.Decimal(12, 2)
  supplier       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  movements  StockMovement[]
  usedBy     ProductMaterial[]

  @@index([companyId])
  @@map("materiais")
}

model StockMovement {
  id         String            @id @default(cuid())
  materialId String
  orderId    String?
  type       StockMovementType
  quantity   Decimal           @db.Decimal(12, 2)
  note       String?
  createdAt  DateTime          @default(now())

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  order    Order?   @relation(fields: [orderId], references: [id])

  @@index([materialId])
  @@index([orderId])
  @@map("movimentos_estoque")
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String
  amountInCents   Int
  status          PaymentStatus @default(PENDING)
  method          String?
  dueDate         DateTime?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("pagamentos")
}

model Attachment {
  id        String   @id @default(cuid())
  orderId   String
  name      String
  url       String
  type      String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("anexos")
}
