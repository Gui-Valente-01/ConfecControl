generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  PRODUCTION
  FINANCE
  SALES
}

enum OrderStatus {
  RECEIVED
  WAITING_MATERIAL
  CUTTING
  SEWING
  EMBROIDERY_PRINT
  FINISHING
  READY
  DELIVERED
  CANCELED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

// Diferencia peça própria de serviço prestado na peça do cliente.
enum ProductKind {
  PRODUCT
  SERVICE
}

enum OrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Company {
  id       String   @id @default(cuid())
  name     String
  document String?  @unique
  phone    String?
  email    String?
  address  String?
  features String[] @default([]) // módulos vendáveis liberados p/ esta empresa (o núcleo é sempre incluso)

  // ---- Identificação e endereço estruturado ----
  // Todos anuláveis. O campo `address` acima é texto livre e serve para a
  // ficha impressa; estes existem para quando o endereço precisa vir em
  // partes (etiqueta, entrega, cadastro formal).
  razaoSocial       String?
  nomeFantasia      String?
  logradouro        String?
  numero            String?
  complemento       String?
  bairro            String?
  municipio         String?
  uf                String?
  cep               String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  users            User[]
  clients          Client[]
  products         Product[]
  orders           Order[]
  productionStages ProductionStage[]
  materials        Material[]
  services         Service[]
  partners         Partner[]
  signupTokens     SignupToken[]
  orderRequests    OrderRequest[]
  mesas            Mesa[]
  bancadaTasks     BancadaTask[]
  avisos           Aviso[]
  pushInscricoes   PushInscricao[]

  @@map("empresas")
}

model SignupToken {
  id             String    @id @default(cuid())
  code           String    @unique
  clientName     String?
  contactEmail   String?
  features       String[]  @default([]) // plano que este token concede à empresa criada
  createdByEmail String
  /** Prazo do convite. Nulo só nos tokens criados antes de existir prazo. */
  expiresAt      DateTime?
  usedAt         DateTime?
  revokedAt      DateTime?
  usedCompanyId  String?
  usedByEmail    String?
  createdAt      DateTime  @default(now())

  usedCompany Company? @relation(fields: [usedCompanyId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([usedCompanyId])
  @@map("tokens_cadastro")
}

model Partner {
  id        String    @id @default(cuid())
  companyId String
  name      String
  service   String?
  contact   String?
  phone     String?
  email     String?
  notes     String?   @db.Text
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // Lixeira: quando preenchido, o cadastro sai das telas mas continua no
  // banco, junto com tudo que depende dele. Sem isso, apagar um material
  // levava embora a ficha tecnica das pecas e o historico de estoque, sem
  // volta. O filtro e aplicado de uma vez so, em src/lib/soft-delete.ts.
  deletedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@index([companyId])
  @@index([deletedAt])
  @@map("terceirizadas")
}

model User {
  id        String   @id @default(cuid())
  companyId String
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(ADMIN)
  sector    String?
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bancadaTasks   BancadaTask[]
  mesas          Mesa[]          @relation("mesaResponsible")
  avisosLidos    AvisoLeitura[]
  pushInscricoes PushInscricao[]

  @@index([companyId])
  @@map("usuarios")
}

model Client {
  id        String  @id @default(cuid())
  companyId String
  name      String
  document  String?
  contact   String?
  phone     String?
  email     String?
  address   String?
  notes     String? @db.Text

  // ---- Endereço estruturado (entrega) ----
  logradouro        String?
  numero            String?
  complemento       String?
  bairro            String?
  municipio         String?
  uf                String?
  cep               String?
  // Portal do cliente (login próprio, conectado à confecção por convite).
  passwordHash      String?
  inviteToken       String?   @unique
  portalEnabled     Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  // Lixeira: quando preenchido, o cadastro sai das telas mas continua no
  // banco, junto com tudo que depende dele. Sem isso, apagar um material
  // levava embora a ficha tecnica das pecas e o historico de estoque, sem
  // volta. O filtro e aplicado de uma vez so, em src/lib/soft-delete.ts.
  deletedAt         DateTime?

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orders        Order[]
  orderRequests OrderRequest[]

  @@index([companyId])
  @@index([deletedAt])
  @@map("clientes")
}

// Solicitação feita pelo cliente no portal; a confecção aceita (vira pedido) ou recusa.
model OrderRequest {
  id               String    @id @default(cuid())
  companyId        String
  clientId         String
  kind             String    @default("NEW") // NEW | REORDER
  referenceOrderId String?
  description      String    @db.Text
  quantity         Int?
  photoUrl         String?
  status           String    @default("PENDING") // PENDING | ACCEPTED | REJECTED
  reviewNote       String?
  reviewedAt       DateTime?
  createdOrderId   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([clientId])
  @@map("solicitacoes")
}

// Mesa/bancada de trabalho (ex.: silk). Cadastro configurável por empresa.
model Mesa {
  id                String   @id @default(cuid())
  companyId         String
  name              String
  active            Boolean  @default(true)
  position          Int      @default(0)
  // Funcionário responsável pela mesa. Não impede outros de usá-la:
  // serve para saber a quem cobrar quando algo trava naquela estação.
  responsibleUserId String?
  // Etapa que esta mesa atende (mesa de silk faz silk). Em branco, a mesa
  // aceita qualquer pedido — que é o estado de quem ainda não configurou, e
  // não pode travar o sistema de quem já estava usando.
  stageId           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  responsible User?            @relation("mesaResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  // Apagar a etapa não apaga a mesa: ela volta a aceitar qualquer pedido.
  stage       ProductionStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  tasks       BancadaTask[]

  @@index([companyId])
  @@index([responsibleUserId])
  @@index([stageId])
  @@map("mesas")
}

// Trabalho de bancada: o funcionário "pega" um pedido numa mesa e depois conclui.
model BancadaTask {
  id           String    @id @default(cuid())
  companyId    String
  orderId      String
  mesaId       String?
  pickedById   String?
  pickedByName String
  status       String    @default("PICKED") // PICKED | DONE
  // Nome da etapa em que o trabalho foi feito, copiado no momento de pegar.
  // É um retrato do passado: nao muda se a etapa for renomeada ou removida depois.
  stageName    String?
  noteKind     String    @default("NONE") // NONE | SHORTAGE | SURPLUS | INFO
  note         String?
  pickedAt     DateTime  @default(now())
  doneAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company  Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order    Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  mesa     Mesa?   @relation(fields: [mesaId], references: [id], onDelete: SetNull)
  pickedBy User?   @relation(fields: [pickedById], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([companyId, status, doneAt])
  @@index([orderId])
  @@index([mesaId])
  @@map("bancada_tarefas")
}

model Product {
  id                    String      @id @default(cuid())
  companyId             String
  name                  String
  category              String?
  size                  String?
  color                 String?
  fabric                String?
  standardPriceInCents  Int         @default(0)
  // Quanto custa a peça pronta para a confecção. Digitado direto: a ficha
  // técnica deixou de alimentar o custo porque exigia manter preço de cada
  // material em dia, e o que ninguém mantém acaba fazendo o lucro mentir.
  costInCents           Int         @default(0)
  // Estoque da peça pronta. Inteiro porque peça se conta em unidades.
  currentQuantity       Int         @default(0)
  minimumQuantity       Int         @default(0)
  // PRODUCT = a confecção faz a peça inteira (material + serviços).
  // SERVICE = o cliente traz a peça e a confecção só presta o serviço.
  kind                  ProductKind @default(PRODUCT)
  averageProductionDays Int?
  imageUrl              String?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  // Lixeira: quando preenchido, o cadastro sai das telas mas continua no
  // banco, junto com tudo que depende dele. Sem isso, apagar um material
  // levava embora a ficha tecnica das pecas e o historico de estoque, sem
  // volta. O filtro e aplicado de uma vez so, em src/lib/soft-delete.ts.
  deletedAt        DateTime?

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items     OrderItem[]
  bom       ProductMaterial[]
  movements StockMovement[]

  @@index([companyId])
  @@index([deletedAt])
  @@map("produtos")
}

// Catálogo de serviços da confecção (silk, costura, bordado, corte...).
// Cada um tem um custo padrão por peça, que serve de sugestão ao vincular.
model Service {
  id                  String    @id @default(cuid())
  companyId           String
  name                String
  defaultPriceInCents Int       @default(0)
  active              Boolean   @default(true)
  position            Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  // Lixeira: quando preenchido, o cadastro sai das telas mas continua no
  // banco, junto com tudo que depende dele. Sem isso, apagar um material
  // levava embora a ficha tecnica das pecas e o historico de estoque, sem
  // volta. O filtro e aplicado de uma vez so, em src/lib/soft-delete.ts.
  deletedAt           DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
  @@index([deletedAt])
  @@map("servicos")
}

// Serviço cobrado dentro de um pedido: nome e valor digitados na hora.
// Fica no pedido, e não na peça, porque o mesmo silk raramente sai pelo mesmo
// preço em dois pedidos. É receita: soma no total que o cliente paga.
model OrderService {
  id           String   @id @default(cuid())
  orderId      String
  name         String
  priceInCents Int      @default(0)
  createdAt    DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("pedido_servicos")
}

model ProductMaterial {
  id              String   @id @default(cuid())
  productId       String
  materialId      String
  quantityPerUnit Decimal  @db.Decimal(12, 3)
  createdAt       DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([productId, materialId])
  @@index([productId])
  @@index([materialId])
  @@map("ficha_tecnica")
}

model Order {
  id                 String        @id @default(cuid())
  companyId          String
  clientId           String
  number             Int
  orderDate          DateTime      @default(now())
  deliveryDate       DateTime?
  status             OrderStatus   @default(RECEIVED)
  priority           OrderPriority @default(NORMAL)
  assignee           String?
  paymentStatus      PaymentStatus @default(PENDING)
  totalAmountInCents Int           @default(0)
  paidAmountInCents  Int           @default(0)
  paymentMethod      String?
  internalNotes      String?       @db.Text
  currentStageId     String?
  partnerId          String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client          Client              @relation(fields: [clientId], references: [id])
  currentStage    ProductionStage?    @relation(fields: [currentStageId], references: [id])
  partner         Partner?            @relation(fields: [partnerId], references: [id])
  items           OrderItem[]
  history         ProductionHistory[]
  payments        Payment[]
  attachments     Attachment[]
  avisos          Aviso[]
  stockMovements  StockMovement[]
  bancadaTasks    BancadaTask[]
  services        OrderService[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([clientId])
  @@index([currentStageId])
  @@index([partnerId])
  @@map("pedidos")
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  productId         String?
  description       String
  size              String?
  color             String?
  quantity          Int
  unitPriceInCents  Int      @default(0)
  totalPriceInCents Int      @default(0)
  createdAt         DateTime @default(now())

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("pedido_itens")
}

model ProductionStage {
  id        String   @id @default(cuid())
  companyId String
  name      String
  position  Int
  color     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  currentOrders Order[]
  mesas         Mesa[]
  fromHistory   ProductionHistory[] @relation("fromStage")
  toHistory     ProductionHistory[] @relation("toStage")

  @@unique([companyId, name])
  @@index([companyId])
  @@map("etapas_producao")
}

model ProductionHistory {
  id          String   @id @default(cuid())
  orderId     String
  fromStageId String?
  toStageId   String
  note        String?
  changedAt   DateTime @default(now())

  order     Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStage ProductionStage? @relation("fromStage", fields: [fromStageId], references: [id])
  toStage   ProductionStage  @relation("toStage", fields: [toStageId], references: [id])

  @@index([orderId])
  @@index([fromStageId])
  @@index([toStageId])
  @@map("historico_status")
}

model Material {
  id                 String    @id @default(cuid())
  companyId          String
  name               String
  category           String?
  unit               String
  currentQuantity    Decimal   @default(0) @db.Decimal(12, 2)
  minimumQuantity    Decimal   @default(0) @db.Decimal(12, 2)
  // Quanto custa 1 unidade de medida do material (1 kg, 1 m, 1 un...).
  // É o que permite a ficha técnica calcular o custo real de cada peça.
  costPerUnitInCents Int       @default(0)
  supplier           String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  // Lixeira: quando preenchido, o cadastro sai das telas mas continua no
  // banco, junto com tudo que depende dele. Sem isso, apagar um material
  // levava embora a ficha tecnica das pecas e o historico de estoque, sem
  // volta. O filtro e aplicado de uma vez so, em src/lib/soft-delete.ts.
  deletedAt          DateTime?

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  movements StockMovement[]
  usedBy    ProductMaterial[]

  @@index([companyId])
  @@index([deletedAt])
  @@map("materiais")
}

model StockMovement {
  id         String            @id @default(cuid())
  // Um movimento aponta para exatamente um lado: peça (daqui pra frente) ou
  // material (histórico anterior à mudança). O banco garante isso na
  // constraint movimento_material_ou_peca.
  materialId String?
  productId  String?
  orderId    String?
  type       StockMovementType
  quantity   Decimal           @db.Decimal(12, 2)
  note       String?
  createdAt  DateTime          @default(now())

  material Material? @relation(fields: [materialId], references: [id], onDelete: Cascade)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  order    Order?    @relation(fields: [orderId], references: [id])

  @@index([materialId])
  @@index([productId])
  @@index([orderId])
  @@map("movimentos_estoque")
}

// Um RECEBIMENTO: dinheiro que entrou, com data e forma. Antes existia uma
// linha só por pedido, com o valor total, atualizada a cada pagamento — não
// dava para saber quando a entrada entrou nem provar recebimento ao cliente.
model Payment {
  id             String        @id @default(cuid())
  orderId        String
  // Impede o mesmo recebimento de entrar duas vezes. O formulario manda uma
  // chave por tentativa; se o duplo clique (ou o retry do navegador) repetir a
  // chave, o banco recusa a segunda insercao. E o unico ponto que resiste a
  // duas requisicoes simultaneas, porque a decisao acontece no banco e nao na
  // aplicacao.
  idempotencyKey String?       @unique
  amountInCents  Int
  status         PaymentStatus @default(PENDING)
  method         String?
  // O que foi este recebimento (ex.: "Entrada do pedido"). Ajuda o dono a se
  // situar no histórico quando há vários no mesmo pedido.
  note           String?
  dueDate        DateTime?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("pagamentos")
}

model Attachment {
  id          String    @id @default(cuid())
  orderId     String
  name        String
  // Endereco publico do arquivo. Mantido apenas para os anexos antigos, que
  // foram gravados assim quando o bucket era publico; anexo novo nao preenche.
  url         String
  // Caminho interno no bucket privado (ex.: "empresa/pedido/arquivo.jpg").
  // Guardar o caminho, e nao a URL, e o que permite o link assinado expirar:
  // URL publica gravada no banco vale para sempre e vaza com um copiar e colar.
  storagePath String?
  type        String?
  // De onde veio o arquivo. Vazio = arte do cliente, que é o caso de tudo que
  // já existe. "BANCADA" = foto tirada pelo funcionário durante a produção.
  //
  // A separação importa: foto do que ficou pronto, ou de um problema, não pode
  // ser confundida com a arte aprovada — senão o próximo funcionário produz
  // olhando a foto errada.
  origem      String?
  // Quem enviou. Só preenchido no que vem da bancada: é o que permite voltar e
  // perguntar para a pessoa certa quando a foto mostra um problema.
  sentBy      String?
  createdAt   DateTime  @default(now())
  // Quem apagou e quando. O arquivo some da tela na hora, mas o registro fica:
  // "sumiu a foto do problema" precisa ter dono e data para ser investigado.
  deletedAt   DateTime?
  deletedBy   String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([deletedAt])
  @@map("anexos")
}

// Aviso para a equipe: o que o sistema percebe sozinho (pedido novo, mudou de
// etapa) e o que uma pessoa precisa pedir (a cor, uma foto, ajuda, um recado).
//
// O segundo grupo hoje acontece por WhatsApp e some: alguem pergunta "qual a
// cor do 1042?" no grupo, respondem tres horas depois, e nada fica no pedido.
model Aviso {
  id        String   @id @default(cuid())
  companyId String
  orderId   String?
  tipo      String
  urgente   Boolean  @default(false)
  titulo    String
  mensagem  String?  @db.Text
  // Nome de quem gerou. Vazio = o proprio sistema.
  criadoPor String?
  createdAt DateTime @default(now())

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Apagar o pedido leva os avisos dele junto: fora do pedido nao fazem sentido.
  order    Order?         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  leituras AvisoLeitura[]

  @@index([companyId, createdAt])
  @@index([orderId])
  @@map("avisos")
}

// Quem ja leu o que. Uma linha por pessoa e aviso: o contador do sino e
// individual, senao um funcionario abrindo a lista zeraria o aviso de todos.
model AvisoLeitura {
  avisoId String
  userId  String
  lidoEm  DateTime @default(now())

  aviso Aviso @relation(fields: [avisoId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([avisoId, userId])
  @@index([userId])
  @@map("avisos_leitura")
}

// Aparelho inscrito para receber notificacao (Web Push).
//
// Uma linha por APARELHO, e nao por pessoa: quem usa o sistema no celular e no
// computador tem duas, e as duas devem tocar. O endpoint e o endereco que o
// servico do navegador (Google, Apple) da para entregar a mensagem.
model PushInscricao {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  // Endereco unico do aparelho no servico de push. Unico no banco porque o
  // navegador reaproveita o mesmo endpoint ao reinscrever.
  endpoint  String   @unique @db.Text
  // Chaves da criptografia ponta a ponta: sem elas o aparelho nao consegue
  // abrir a mensagem. Quem envia nao le o que ja mandou.
  p256dh    String
  auth      String
  // Para a pessoa reconhecer o aparelho numa lista, se um dia precisar.
  aparelho  String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
  @@map("push_inscricoes")
}

// Freio de tentativas compartilhado entre todas as instancias.
//
// O limitador anterior vivia num Map na memoria do processo. Em serverless cada
// requisicao pode cair numa instancia nova, entao o contador reiniciava sozinho
// e o freio nao freava nada: bastava insistir para acertar a senha.
//
// Uma linha por chave ("login:maria@x.com", "portal:ip"). A decisao acontece no
// banco, que e o unico lugar que todas as instancias enxergam igual.
model RateLimit {
  chave        String    @id
  tentativas   Int       @default(0)
  janelaInicio DateTime  @default(now())
  // Bloqueio progressivo: cada faixa de tentativas empurra este horario para
  // mais longe. Nulo quando a chave nunca estourou o limite.
  bloqueadoAte DateTime?
  atualizadoEm DateTime  @updatedAt

  @@index([bloqueadoAte])
  @@map("rate_limit")
}
