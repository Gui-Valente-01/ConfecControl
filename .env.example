DATABASE_URL="postgresql://usuario:SUA_SENHA_AQUI@localhost:5432/confeccontrol"

# Contato de suporte mostrado na tela de login, para quem não consegue entrar.
# Os dois são opcionais: o que ficar em branco simplesmente não aparece.
SUPPORT_WHATSAPP="(41) 99999-9999"
SUPPORT_EMAIL="suporte@suaempresa.com"

# Aviso de erro (Sentry). Tudo opcional: sem estas variáveis o sistema roda
# igual, só não avisa quando algo quebra na máquina de um cliente.
#
# A primeira é a única obrigatória para começar a receber os avisos. As três
# de baixo servem para o erro chegar apontando a linha do código-fonte, em vez
# de uma linha embaralhada; sem elas o build funciona do mesmo jeito.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
