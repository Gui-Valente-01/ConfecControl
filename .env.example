DATABASE_URL="postgresql://usuario:SUA_SENHA_AQUI@localhost:5432/confeccontrol"

# Endereço público do site, sem barra no final. É o que o sitemap entrega ao
# Google e o que aparece no link colado no WhatsApp. Use a versão para a qual
# as outras redirecionam (aqui, a com www). Sem esta variável o sistema já usa
# o domínio de produção definido em src/lib/site.ts.
NEXT_PUBLIC_SITE_URL="https://www.confeccontrol.com"

# Código de verificação do Google Search Console (opção "tag HTML"): cole aqui
# só o valor do content, sem a tag inteira. Em branco, a tag não é gerada.
GOOGLE_SITE_VERIFICATION=""

# Contato de suporte mostrado na tela de login, para quem não consegue entrar.
# Os dois são opcionais: o que ficar em branco simplesmente não aparece.
SUPPORT_WHATSAPP="(41) 99999-9999"
SUPPORT_EMAIL="suporte@suaempresa.com"

# Aviso de erro (Sentry). Tudo opcional: sem estas variáveis o sistema roda
# igual, só não avisa quando algo quebra na máquina de um cliente.
#
# A primeira é a única obrigatória para começar a receber os avisos. As três
# de baixo servem para o erro chegar apontando a linha do código-fonte, em vez
# de uma linha embaralhada; sem elas o build funciona do mesmo jeito.
#
# Onde achar cada uma, no painel do sentry.io:
#   DSN         Settings > Client Keys (DSN). Nao e segredo: ele vai embutido
#               na pagina. E a unica necessaria para os avisos comecarem.
#   AUTH_TOKEN  Settings > Auth Tokens. ESTE E SEGREDO: cadastre direto no
#               painel do Vercel, nunca num arquivo do projeto.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG="gui-valent"
SENTRY_PROJECT="javascript-nextjs"
SENTRY_AUTH_TOKEN=""

# ---------------------------------------------------------------------------
# Fiscal (NF-e)
# ---------------------------------------------------------------------------
# NADA disto esta ligado hoje. O provedor padrao e o FALSO, que emite notas que
# nao existem para a SEFAZ e servem apenas para testar a tela e o fluxo.
#
# Emitir NF-e de verdade exige, alem destas variaveis: contrato com um provedor,
# certificado digital A1 da empresa, e o contador validando o perfil tributario.
# Nao ligue producao sem os tres.

# Qual provedor usar: "falso" (padrao) ou o nome de um adaptador real.
FISCAL_PROVIDER="falso"

# Ambiente fiscal: "homologacao" (padrao) ou "producao".
# Homologacao emite contra o ambiente de teste da SEFAZ: a nota tem numero e
# protocolo, mas nao tem validade fiscal. E onde tudo deve ser exercitado.
FISCAL_AMBIENTE="homologacao"

# Trava extra para producao. Mesmo com FISCAL_AMBIENTE="producao", a emissao
# real so acontece com esta variavel valendo "sim". Existe porque trocar o
# ambiente por engano gera documento fiscal de verdade -- que da multa e nao
# se apaga.
FISCAL_PRODUCAO_LIBERADA="nao"

# Credenciais do provedor real. SEGREDO: cadastre no painel da Vercel, nunca
# num arquivo do projeto. Deixe vazio enquanto usar o provedor falso.
FISCAL_API_TOKEN=""
# Segredo usado para conferir a assinatura do webhook do provedor. Sem ele, o
# endpoint de webhook recusa tudo -- que e o comportamento correto.
FISCAL_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Paginas legais (privacidade e termos)
# ---------------------------------------------------------------------------
# Sao declaracoes juridicas: dizem quem controla os dados e com quem falar.
# Sem estes valores, as paginas ficam no ar avisando que estao incompletas --
# de proposito, para a lacuna nao passar despercebida por meses.
LEGAL_RAZAO_SOCIAL=""
LEGAL_CNPJ=""
LEGAL_ENDERECO=""
LEGAL_EMAIL_PRIVACIDADE=""

# Encarregado pelo tratamento de dados (LGPD, art. 41). E a pessoa que recebe
# reclamacao de titular e conversa com a ANPD. Pode ser o proprio dono, mas
# precisa ter nome e canal publicos -- a lei exige que a identidade seja
# divulgada.
LEGAL_ENCARREGADO_NOME=""
LEGAL_ENCARREGADO_EMAIL=""

# Data e versao do texto em vigor. Trocar SEMPRE que o conteudo mudar: e o que
# permite provar o que valia em cada periodo.
LEGAL_ATUALIZADO_EM="18 de agosto de 2026"
LEGAL_VERSAO="1.0"
